// Package sources with explicit path properties
target "server" type="server"

package "webmap" {
    download "https://example.com/bluemap-4.0.jar" path="downloads/bluemap.jar"
    artifact "downloads/bluemap.jar" "plugins/bluemap.jar"
}

package "custom-mod" {
    git "https://github.com/example/custom-mod.git" path="src/mod"
    build {
        execute "./gradlew" cd="src/mod"
    }
    artifact "build/libs/custom-mod.jar" "mods/custom-mod.jar"
}
