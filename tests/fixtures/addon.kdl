// Every addon type, positionally and by name

use papermc paper version="1.21.1" build="132"

dir "plugins" {
    use modrinth luckperms version="latest" files="luckperms.jar"
    use modrinth id=spark
    use hangar ViaVersion version="latest"
    use curseforge "238222"
    use github "PaperMC/Velocity" tag="latest" asset="velocity-*.jar"
    use maven com.example mylib version="1.0-SNAPSHOT" classifier="all"
    use download "https://example.com/plugins/custom.jar" sha1="fc8bb9919fa77c670b7ed5c284bcb66770ea71fc" size=1
}

dir "mods" {
    use fabric loader="0.16.5" installer="1.0.1"
    use modrinth create version="beta"
    use modrinth a:b
}

target "smp" path="./run/smp" type="server"
