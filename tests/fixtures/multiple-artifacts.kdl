// Package producing multiple output files via several artifact directives
target "server" type="server"

package "big-plugin" {
    download "https://example.com/big-plugin-2.0.jar"
    artifact "big-plugin-2.0.jar" "plugins/big-plugin.jar"
    artifact "big-plugin-2.0.jar" "plugins/backup/big-plugin.jar"
}
