// Manifest paired with lock-diff.kdl
platform "paper" minecraft="1.21.1"

target "smp" path="./run/smp" type="server"

dir "plugins" {
    use "modrinth:luckperms" version="latest"

    package "customplugin" {
        download "https://example.com/custom.jar"
        artifact "custom.jar"
    }
}
