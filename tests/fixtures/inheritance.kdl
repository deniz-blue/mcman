// Root content reaches every target, an ancestor reaches its descendants,
// and siblings never see each other.

dir "plugins" {
    use modrinth luckperms version="5.4.0"
}

group "servers" {
    dir "plugins" {
        use modrinth spark version="1.10"
    }

    group "lobby" {
        target "lobby" path="./run/lobby" type="server"

        dir "plugins" {
            use modrinth fastasyncworldedit version="latest"
        }
    }

    group "smp" {
        target "smp" path="./run/smp" type="server"
    }
}

group "unreachable" {
    dir "mods" {
        use modrinth sodium version="latest"
    }
}
