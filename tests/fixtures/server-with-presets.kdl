// Server target with preset dependencies in a dir block
target "smp" path="./run/smp" type="server"

dir "plugins" {
    use "modrinth:luckperms" version="latest"
    use "modrinth:spark" version="latest"
    use "modrinth:essentialsx" version="latest"
}

dir "mods" {
    use "modrinth:fabric-api" version="latest"
}
